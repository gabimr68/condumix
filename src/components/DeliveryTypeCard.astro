---
interface Props {
  icon?: string;   
  title?: string;
  description: string;
  isBig: boolean;
  number?: string;
}

const { icon, title, description, isBig, number } = Astro.props;
---
{isBig ? (
    <div class="flex flex-col max-w-[384px] gap-4 bg-[#0A2540] p-8 items-center justify-center shadow-md ">
    <img src={icon} alt={title} class="w-[50px] h-[50px] object-contain mb-2" />
    <h3 class="text-[#ffffff] text-xl font-cabin text-center">{title}</h3>
    <p class="text-[#ffffff] text-base font-cabin text-center">{description}</p>
    </div>
):(
    <div class="flex flex-col max-w-[288px] bg-[#0A2540] py-4 px-16 md:px-10 lg:px-16 items-center justify-center shadow-md ">
    <h3 class="text-[#ffffff] text-xl font-cabin text-center">{number}</h3>
    <p class="text-[#ffffff] text-base font-cabin text-center">{description}</p>
    </div>
)}