---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div
  class="flex flex-col w-[280px] gap-4 bg-white p-6 items-center justify-center shadow-md border-t-[5px] border-[#0A2540]"
>
  <img src={icon} alt={title} class="w-[64px] h-[64px] object-contain mb-2" />
  <h3 class="text-[#0A2540] text-lg font-cabin font-semibold text-center">
    {title}
  </h3>
  <p class="text-[#7B7B7B] text-sm font-cabin text-center">{description}</p>
</div>
